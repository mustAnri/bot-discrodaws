# Salin file ini menjadi .env lalu isi nilainya
# Windows:  copy .env.example .env

# Token bot dari https://discord.com/developers/applications
# Bot > Reset Token
TOKEN=isi_token_bot_disini

# Application ID dari halaman General Information
CLIENT_ID=isi_client_id_disini

# ID server Discord tempat command di-deploy (guild commands)
GUILD_ID=isi_guild_id_disini

# Lokasi penyimpanan data handlerData.json & config.json
# Di Railway set ke /data (volume mount point). Lokal bisa dikosongkan.
DATA_DIR=/data

# Password untuk login admin panel web (WAJIB diisi untuk deploy!)
ADMIN_PASSWORD=isi_password_admin_disini

# Kunci enkripsi token auto verif (SANGAT DISARANKAN, apalagi kalau web dipakai rame-rame).
# Token di file data akan disimpan terenkripsi AES-256-GCM, bukan plaintext.
# Isi dengan kalimat/kunci rahasia panjang. Kalau dikosongkan, token tetap plaintext.
AC_ENC_KEY=isi_kunci_rahasia_disini

# Port admin panel web. Di Railway, kosongkan saja (otomatis pakai PORT dari Railway)
# PORT=3000
